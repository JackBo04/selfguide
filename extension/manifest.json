{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "SelfGuide Text Bridge",
  "version": "0.5.0",
  "version_name": "0.5.0",
  "description": "Give each Codex task its own ChatGPT window, sharing your existing browser login.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
